{
  "manifest_version": 3,
  "name": "Apex IG Unfollowers",
  "short_name": "Apex IGU",
  "author": "Konrad Woźniak",
  "version": "1.0.0",
  "description": "Sprawdza, kto nie obserwuje Cię na Instagramie, kogo Ty nie obserwujesz i kto przestał Cię obserwować. Lokalnie, bez konta i telemetrii.",
  "minimum_chrome_version": "121",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content/unfollowers.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Apex IG Unfollowers",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "apex-igunfollowers@apexsoftware.app",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
