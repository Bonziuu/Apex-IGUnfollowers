<?xml version="1.0" encoding="utf-8"?>
<!-- Dane aplikacji (sesja Instagrama, wyniki skanów) nie trafiają do kopii w chmurze ani na inne urządzenia.
     Do przenosin służy kopia zapasowa JSON w ustawieniach panelu. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
